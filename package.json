{
  "name": "kidstop-backoffice",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prod": "next dev -p 3120",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "codegen": "graphql-codegen && prettier --write \"src/lib/api/schema-types.ts\" \"src/lib/api/generated/**/*.generated.ts\" && eslint \"src/lib/api/schema-types.ts\" \"src/lib/api/generated/**/*.generated.ts\" --fix",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:chrome": "cypress run --browser chrome",
    "cypress:run:firefox": "cypress run --browser firefox",
    "test:e2e": "cypress run",
    "test:e2e:headed": "cypress run --headed",
    "prepare": "husky",
    "validate": "npm run lint && npm run format:check && tsc --noEmit"
  },
  "dependencies": {
    "@apollo/client": "^4.0.9",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@heroui/react": "^2.8.5",
    "@hookform/resolvers": "^5.2.2",
    "apollo-upload-client": "^19.0.0",
    "dayjs": "^1.11.19",
    "dotenv": "^16.6.1",
    "framer-motion": "^12.23.24",
    "graphql": "^16.12.0",
    "jspdf": "^4.1.0",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.66.0",
    "react-hot-toast": "^2.6.0",
    "react-use": "^17.6.1",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^26.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@graphql-codegen/cli": "^6.0.2",
    "@graphql-codegen/near-operation-file-preset": "^5.2.1",
    "@graphql-codegen/typed-document-node": "^6.1.2",
    "@graphql-codegen/typescript": "^5.0.4",
    "@graphql-codegen/typescript-operations": "^5.0.4",
    "@iconify/react": "^6.0.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/cypress": "^10.1.3",
    "@types/apollo-upload-client": "^19.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^11.0.0",
    "baseline-browser-mapping": "^2.9.19",
    "cypress": "^15.18.1",
    "cypress-terminal-report": "^7.3.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "uuid": "^14.0.1"
  }
}
